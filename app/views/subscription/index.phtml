<?php $this->partial('aside_subscription'); ?>

<div class="post">
	<a href="<?= _url('subscription', 'add') ?>"><?= _t('sub.title.add') ?></a>
</div>

<!-- FEATURE: Reorder Toggle Button
     This button enables the "Edit Mode" for feed sorting. 
     We intentionally require an explicit toggle to prevent accidental drag-and-drop
     actions while scrolling on touch devices. -->
<div class="post">
	<button class="btn" id="btn-toggle-reorder" type="button" title="Enable feed reordering">
		<?= _i('move') ?> Toggle Reorder
	</button>
</div>

<?php foreach ($this->categories as $category) { ?>
<div class="box">
	<div class="box-title">
		<a class="configure" href="<?= _url('subscription', 'category', 'id', $category->id()) ?>">
			<?= _i('configure') ?>
		</a>
		<?= $category->name() ?>
	</div>
	<ul class="feeds" data-category="<?= $category->id() ?>">
	<?php foreach ($category->feeds() as $feed) { ?>
		<!-- FEATURE: Feed Reordering Data Attributes
		     We expose the feed ID and its current priority to the DOM. 
		     This allows our JavaScript to implement a minimal-invasive "lexical sorting" 
		     (calculating the midpoint between neighbors) without hitting the DB heavily. -->
		<li class="item feed" 
			data-feed-id="<?= $feed->id() ?>" 
			data-priority="<?= $feed->priority() ?>">
			
			<!-- FEATURE: Drag-and-drop and Accessibility controls
			     Hidden by default. Shown when #btn-toggle-reorder is activated.
			     Up/Down buttons guarantee full accessibility (a11y) and provide a 
			     fallback for mobile devices where native HTML5 drag-and-drop is flaky. -->
			<span class="reorder-controls" style="display: none; margin-right: 10px; vertical-align: middle;">
				<button type="button" class="btn btn-reorder-up" title="Move up" style="padding: 2px 5px;"><?= _i('up') ?></button>
				<button type="button" class="btn btn-reorder-down" title="Move down" style="padding: 2px 5px;"><?= _i('down') ?></button>
				<span class="drag-handle" style="cursor: grab; padding: 0 10px; font-size: 1.2em;">☰</span>
			</span>

			<a class="configure" href="<?= _url('subscription', 'feed', 'id', $feed->id()) ?>">
				<?= _i('configure') ?>
			</a>

			<a href="<?= _url('index', 'index', 'get', 'f_' . $feed->id()) ?>">
				<img class="favicon" src="<?= $feed->favicon() ?>" alt="✇" loading="lazy" />
				<?= $feed->name() ?>
			</a>

			<?php if ($feed->inError()) { ?>
				<span class="alert"> <?= _t('sub.feed.error') ?></span>
			<?php } elseif ($feed->nbEntries() == 0) { ?>
				<span class="alert"> <?= _t('sub.feed.empty') ?></span>
			<?php } ?>
		</li>
	<?php } ?>
	</ul>
</div>
<?php } ?>
